# ──────────────────────────────────────────────────────────────
# PRODUCTION CONFIG — Hostinger
#
# 1. Rename this file to ".env"
# 2. Fill in GOOGLE_API_KEY below
# 3. Upload the ".env" file alongside server.js
# ──────────────────────────────────────────────────────────────

# Get a FREE key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_api_key_here

# Gemini model to use via Google AI Studio (free tier available).
#   gemini-2.0-flash    (fast and capable, recommended default)
#   gemini-1.5-flash    (fast, lower cost)
#   gemini-1.5-pro      (most capable, lower free-tier limits)
GOOGLE_MODEL=gemini-2.0-flash

# Force Google API as the provider.
# Hostinger has no Ollama running, so this skips the local-AI
# check on every request and avoids a startup delay.
AI_PROVIDER=google

# Hostinger's Node.js app manager sets PORT automatically.
# This value is only used as a fallback for local testing.
PORT=3000
