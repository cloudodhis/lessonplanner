# ──────────────────────────────────────────────────────────────
# PRODUCTION CONFIG — Hostinger
#
# 1. Rename this file to ".env"
# 2. Fill in ANTHROPIC_API_KEY below
# 3. Upload the ".env" file alongside server.js
# ──────────────────────────────────────────────────────────────

# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model to use.
#   claude-sonnet-4-6              (recommended default — strong quality)
#   claude-opus-4-8                (most capable, higher cost)
#   claude-haiku-4-5                (fastest / cheapest)
CLAUDE_MODEL=claude-sonnet-4-6

# Force Claude as the provider.
# Hostinger has no Ollama running, so this skips the local-AI
# check on every request and avoids a startup delay.
AI_PROVIDER=claude

# ── Optional fallback (Google AI Studio) ───────────────────────
# Get a FREE key at: https://aistudio.google.com/app/apikey
# Only used if AI_PROVIDER=auto and ANTHROPIC_API_KEY is not set.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Hostinger's Node.js app manager sets PORT automatically.
# This value is only used as a fallback for local testing.
PORT=3000
