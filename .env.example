# ──────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in your values.
# The .env file is never uploaded — keep your API key private.
# ──────────────────────────────────────────────────────────────

# Port the web app listens on (default: 3000)
PORT=3000

# ── Local AI (Ollama) ──────────────────────────────────────────
# Used automatically if Ollama is running on this machine.
# Download from https://ollama.com and run: ollama pull llama3
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest

# ── Cloud AI (Claude / Anthropic) ───────────────────────────────
# Primary cloud provider. Get a key at: https://console.anthropic.com
# Used automatically if Ollama is not available.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Claude model to use.
# Common options:
#   claude-sonnet-4-6              (recommended default — strong quality)
#   claude-opus-4-8                (most capable, higher cost)
#   claude-haiku-4-5                (fastest / cheapest)
CLAUDE_MODEL=claude-sonnet-4-6

# ── Cloud AI (Google AI Studio) ────────────────────────────────
# Secondary fallback if Claude is not configured.
# Get a FREE key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Gemini model to use via Google AI Studio (free tier available).
# Common options:
#   gemini-2.0-flash    (fast and capable, recommended default)
#   gemini-1.5-flash    (fast, lower cost)
#   gemini-1.5-pro      (most capable, lower free-tier limits)
GOOGLE_MODEL=gemini-2.0-flash

# ── Provider override ───────────────────────────────────────────
# auto   = use Ollama if running, else Claude, else Google (default)
# ollama = always use Ollama (fails if not running)
# claude = always use Claude (skips Ollama check — use this on hosting)
# google = always use Google API (skips Ollama check)
AI_PROVIDER=auto
